test compile precise-output
set opt_level=speed
set preserve_frame_pointers=true
target x86_64

; Dot product where xs is known to hold n elements and ys[i] is checked
; against ys_len. Equivalent Rust:
;
;     for i in 0..n {
;         if i >= ys_len { trap_index_oob(i, ys_len) }
;         t = t.wrapping_add(xs[i] * ys[i]);
;     }
function %dot_call(i64, i64, i64, i64) -> i64 system_v {
    sig0 = (i64, i64) system_v
    fn0 = %trap_index_oob sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v100 = iconst.i64 3
    v101 = iconst.i64 1
    ; v0 = xs, v1 = ys, v2 = n, v3 = ys_len
    v4 = iconst.i64 0
    v5 = icmp sgt v2, v4
    brif v5, block1(v4, v4), block4(v4)

block1(v6: i64, v7: i64):
    ; v6 = i, v7 = t
    v8 = icmp ult v6, v3
    brif v8, block3, block2

block2 cold:
    call fn0(v6, v3)
    trap user1

block3:
    v9 = ishl v6, v100
    v10 = iadd v0, v9
    v11 = load.i64 notrap aligned v10
    v12 = iadd v1, v9
    v13 = load.i64 notrap aligned v12
    v14 = imul v11, v13
    v15 = iadd v7, v14
    v16 = iadd v6, v101
    v17 = icmp slt v16, v2
    brif v17, block1(v16, v15), block4(v15)

block4(v18: i64):
    return v18
}

; Control: the same loop whose failed check only traps.
function %dot_trap(i64, i64, i64, i64) -> i64 system_v {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v100 = iconst.i64 3
    v101 = iconst.i64 1
    v4 = iconst.i64 0
    v5 = icmp sgt v2, v4
    brif v5, block1(v4, v4), block4(v4)

block1(v6: i64, v7: i64):
    v8 = icmp ult v6, v3
    brif v8, block3, block2

block2 cold:
    trap user1

block3:
    v9 = ishl v6, v100
    v10 = iadd v0, v9
    v11 = load.i64 notrap aligned v10
    v12 = iadd v1, v9
    v13 = load.i64 notrap aligned v12
    v14 = imul v11, v13
    v15 = iadd v7, v14
    v16 = iadd v6, v101
    v17 = icmp slt v16, v2
    brif v17, block1(v16, v15), block4(v15)

block4(v18: i64):
    return v18
}
